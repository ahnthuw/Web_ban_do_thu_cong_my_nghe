@model Web_ban_do_thu_cong_my_nghe.ViewModels.ForgotPasswordVM
@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    ViewData["Title"] = ViewData["Title"] ?? "Quên mật khẩu";
    var statusMessage = TempData["StatusMessage"] as string;
}

<style>
    :root {
        --admin-primary: #f0821b;
        --admin-primary-light: #ffbf75;
        --admin-primary-dark: #d46f12;
        --admin-bg: #f4f7fc;
        --input-border: #ddd;
        --card-bg: #ffffff;
        --muted-text: #6c6c6c;
    }

    .forgot-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, rgba(240, 130, 27, 0.08), rgba(255, 190, 117, 0.15));
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .forgot-card {
        width: 100%;
        max-width: 480px;
        background: var(--card-bg);
        border-radius: 24px;
        padding: 36px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        text-align: center;
        border: 1px solid rgba(240, 130, 27, 0.25);
    }

        .forgot-card h1 {
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 6px;
            color: #2b2b2b;
        }

        .forgot-card p.lead {
            color: var(--muted-text);
            margin-bottom: 24px;
        }

    .forgot-form {
        text-align: left;
    }

    .forgot-form label {
        font-weight: 600;
        color: #3b3b3b;
    }

    .forgot-form .form-control-custom {
        width: 100%;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid var(--input-border);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        font-size: 1rem;
    }

        .forgot-form .form-control-custom:focus {
            border-color: var(--admin-primary);
            box-shadow: 0 0 0 3px rgba(240, 130, 27, 0.1);
            outline: none;
        }

    .btn-verify {
        width: 100%;
        border: none;
        padding: 14px 20px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark));
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: 0.02em;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-verify:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 25px rgba(240, 130, 27, 0.25);
        }

    .back-login {
        margin-top: 18px;
        font-weight: 600;
    }

        .back-login a {
            color: var(--admin-primary);
            text-decoration: none;
        }

            .back-login a:hover {
                text-decoration: underline;
            }

    .status-alert {
        border-radius: 12px;
        background: rgba(46, 160, 67, 0.08);
        border: 1px solid rgba(46, 160, 67, 0.2);
        padding: 12px 16px;
        color: #2e7742;
        font-weight: 500;
        text-align: left;
        margin-bottom: 20px;
    }

    @@media (max-width: 576px) {
        .forgot-card {
            padding: 28px 22px;
        }
    }
</style>

<div class="forgot-wrapper">
    <div class="forgot-card">
        <h1>Quên mật khẩu</h1>
        

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="status-alert">@statusMessage</div>
        }

        <form asp-action="QuenMatKhau" method="post" class="forgot-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control-custom" placeholder="Nhập tên đăng nhập" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control-custom" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control-custom" placeholder="Nhập email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-verify">Xác thực</button>
        </form>

        <div class="back-login">
            <a asp-action="DangNhap">&larr; Quay lại đăng nhập</a>
        </div>
    </div>
</div>
