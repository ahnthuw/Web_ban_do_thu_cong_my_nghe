@model Web_ban_do_thu_cong_my_nghe.ViewModels.LoginVM
@{
    var loginTitle = ViewBag.LoginTitle as string ?? "Đăng nhập hệ thống";
    var loginDescription = ViewBag.LoginDescription as string;
    var formAction = ViewBag.FormAction as string ?? "DangNhap";
    var formController = ViewBag.FormController as string ?? "KhachHang";
    var showForgot = ViewBag.ShowForgot is bool flag ? flag : true;
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = loginTitle;
}

<style>
    /* CSS TÙY CHỈNH CHO GIAO DIỆN ĐĂNG NHẬP */

    :root {
        --admin-primary: #f0821b; /* Màu cam chủ đạo */
        --admin-primary-light: #ffbf75; /* Màu cam nhạt */
        --admin-primary-dark: #d46f12; /* Màu cam đậm khi hover */
        --admin-bg: #f4f7fc; /* Màu nền nhẹ của Dashboard */
        --input-border: #ddd;
        --card-bg: #ffffff;
    }

    /* Vùng chứa toàn bộ trang */
    .login-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, rgba(240, 130, 27, 0.08), rgba(255, 190, 117, 0.15));
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    /* Khối Card Đăng nhập */
    .login-card {
        max-width: 480px;
        width: 100%;
        background: var(--card-bg);
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        padding: 36px;
        text-align: center;
        border: 1px solid rgba(240, 130, 27, 0.25);
    }

        .login-card h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #333;
        }

    .form-group-custom {
        text-align: left;
        margin-bottom: 20px;
    }

        .form-group-custom label {
            font-weight: 500;
            color: #555;
            margin-bottom: 5px;
            display: block;
            font-size: 0.9rem;
        }

    .form-control-custom {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        transition: border-color 0.3s;
        box-shadow: none;
    }

        .form-control-custom:focus {
            border-color: var(--admin-primary);
            outline: none;
        }

    /* Nút Đăng nhập */
    .btn-login-custom {
        background: var(--admin-primary);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 6px;
        font-weight: 600;
        width: 100%;
        margin-top: 10px;
        transition: background 0.3s;
    }

        .btn-login-custom:hover {
            background: var(--admin-primary-dark);
        }

    .forgot-password {
        display: block;
        text-align: right;
        font-size: 0.85rem;
        margin-top: 5px;
        color: #888;
    }

    .register-link {
        margin-top: 20px;
        font-size: 0.9rem;
        color: #555;
    }

        .register-link a {
            color: var(--admin-primary);
            font-weight: 600;
            text-decoration: none;
        }
</style>


<div class="login-wrapper">
    <div class="login-card">
        <h1>@loginTitle</h1>

        @if (!string.IsNullOrWhiteSpace(loginDescription))
        {
            <p class="text-muted">@loginDescription</p>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="@formAction" asp-controller="@formController" method="post">
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group-custom">
                <label asp-for="TenDangNhap">Tên đăng nhập</label>
                <input asp-for="TenDangNhap" class="form-control-custom" placeholder="Nhập tên đăng nhập" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="Password">Mật khẩu</label>
                <input asp-for="Password" class="form-control-custom" type="password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>

                @if (showForgot)
                {
                    <a asp-controller="@formController" asp-action="QuenMatKhau" class="forgot-password">Quên mật khẩu?</a>
                }
            </div>

            <button type="submit" class="btn-login-custom">Đăng Nhập</button>

            <div class="register-link">
                Chưa có tài khoản? <a asp-controller="@formController" asp-action="DangKy">Đăng ký ngay</a>
            </div>
        </form>
    </div>
</div>