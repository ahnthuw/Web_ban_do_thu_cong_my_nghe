@model Web_ban_do_thu_cong_my_nghe.ViewModels.Contact.ContactConversationVM
@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    ViewData["Title"] = "Liên hệ";
    var statusMessage = TempData["StatusMessage"] as string;
}

<style>
    :root {
        --chat-primary: #f0821b;
        --chat-primary-dark: #d46f12;
        --chat-bg: #faf5ef;
        --chat-card: #ffffff;
        --chat-border: #f2d3b0;
    }

    .contact-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(240, 130, 27, 0.08), rgba(255, 190, 117, 0.12));
        padding: 40px 15px;
    }

    .contact-card {
        width: 100%;
        max-width: 860px;
        background: var(--chat-card);
        border-radius: 28px;
        border: 1px solid rgba(240, 130, 27, 0.2);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .contact-header {
        padding: 24px 28px;
        background: var(--chat-bg);
        border-bottom: 1px solid rgba(240, 130, 27, 0.2);
    }

    .contact-header h1 {
        font-size: 1.6rem;
        margin-bottom: 4px;
        color: #2f2f2f;
    }

    .contact-body {
        display: flex;
        flex-direction: column;
        padding: 24px 28px;
    }

    .chat-stream {
        max-height: 420px;
        overflow-y: auto;
        padding-right: 10px;
        margin-bottom: 20px;
    }

    .chat-bubble {
        padding: 12px 16px;
        border-radius: 18px;
        margin-bottom: 14px;
        max-width: 80%;
        position: relative;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        line-height: 1.4;
    }

    .chat-bubble.customer {
        margin-right: auto;
        background: #fff8ef;
        border: 1px solid var(--chat-border);
    }

    .chat-bubble.admin {
        margin-left: auto;
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-primary-dark));
        color: #fff;
    }

    .chat-timestamp {
        display: block;
        font-size: 0.8rem;
        margin-top: 6px;
        opacity: 0.7;
    }

    .compose-form textarea {
        width: 100%;
        min-height: 110px;
        border-radius: 16px;
        border: 1px solid #e5d7c6;
        padding: 14px;
        resize: vertical;
        font-size: 1rem;
    }

    .compose-actions {
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .btn-send {
        border: none;
        border-radius: 999px;
        padding: 12px 28px;
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-primary-dark));
        color: #fff;
        font-weight: 600;
        letter-spacing: 0.02em;
        box-shadow: 0 12px 30px rgba(240, 130, 27, 0.28);
    }

    .status-alert {
        border-radius: 12px;
        background: rgba(46, 160, 67, 0.08);
        border: 1px solid rgba(46, 160, 67, 0.2);
        padding: 12px 16px;
        color: #1f7b3f;
        font-weight: 500;
        margin-bottom: 16px;
    }

    @@media (max-width: 768px) {
        .contact-card {
            border-radius: 20px;
        }

        .chat-bubble {
            max-width: 100%;
        }
    }
</style>

<div class="contact-wrapper">
    <div class="contact-card">
        <div class="contact-header">
            <h1>Liên hệ hỗ trợ</h1>
            <p class="text-muted mb-0">Nhắn tin trực tiếp với quản trị viên để được trợ giúp nhanh chóng.</p>
        </div>

        <div class="contact-body">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="status-alert">@statusMessage</div>
            }

            @if (Model == null || Model.PartnerId == 0)
            {
                <p class="text-center text-muted mb-0">Hiện tại chưa có quản trị viên sẵn sàng. Vui lòng quay lại sau.</p>
            }
            else
            {
                <div class="chat-stream">
                    @if (Model.Messages.Any())
                    {
                        foreach (var message in Model.Messages)
                        {
                            var bubbleClass = message.IsOwn ? "chat-bubble customer" : "chat-bubble admin";
                            if (message.IsOwn)
                            {
                                <div class="@bubbleClass">
                                    <div>@message.Content</div>
                                    <span class="chat-timestamp">@message.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                            else
                            {
                                <div class="@bubbleClass">
                                    <strong>@Model.PartnerRoleLabel:</strong>
                                    <div>@message.Content</div>
                                    <span class="chat-timestamp">@message.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted">Chưa có tin nhắn nào. Hãy gửi câu hỏi đầu tiên của bạn bên dưới.</p>
                    }
                </div>

                <form asp-action="LienHe" method="post" class="compose-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <label asp-for="Composer.Message" class="form-label fw-semibold">Nội dung tin nhắn</label>
                    <textarea asp-for="Composer.Message" placeholder="Nhập câu hỏi hoặc yêu cầu tại đây..."></textarea>
                    <span asp-validation-for="Composer.Message" class="text-danger"></span>
                    <div class="compose-actions">
                        <button type="submit" class="btn-send">Gửi tin nhắn</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
