@using System.Linq
@model IEnumerable<Web_ban_do_thu_cong_my_nghe.Data.User>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nhân viên</h1>
        <p class="page-subtitle">Danh sách nhân sự và phân quyền</p>
    </div>
    <div class="header-actions">
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-success" asp-controller="Admin" asp-action="Dashboard">
                <i class="fa fa-chart-line me-2"></i>Quay về Dashboard
            </a>
            <a class="btn btn-outline-light text-dark" asp-controller="Admin" asp-action="Users">
                <i class="fa fa-users-gear me-2"></i>Quản lý người dùng
            </a>
        </div>
    </div>

</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Mã NV</th>
                    <th>Họ tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có tài khoản nhân viên.</td>
                    </tr>
                }
                else
                {
                    foreach (var staff in Model)
                    {
                        <tr>
                            <td>#@staff.Id</td>
                            <td>@staff.Fullname</td>
                            <td>@staff.TenDangNhap</td>
                            <td>@staff.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(staff.PhoneNumber) ? "-" : staff.PhoneNumber)</td>
                            <td>
                                <span class="badge @(staff.Status ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @(staff.Status ? "Hoạt động" : "Đã khóa")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Admin" asp-action="EditRole" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-primary">Cập nhật</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
