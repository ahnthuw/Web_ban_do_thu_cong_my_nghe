@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Bootstrap + FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>

<body class="admin-body">
    <div class="admin-shell">

        <!-- SIDEBAR -->
        <nav class="admin-sidebar">
            <div class="brand-block">
                <div class="brand-icon"><i class="fa fa-feather"></i></div>
                <div>
                    <p class="brand-label">Mỹ Nghệ Việt</p>
                    <strong class="brand-title">Quản trị viên</strong>
                </div>
            </div>

            <!-- Tổng quan -->
            <div class="admin-nav-section">
                <p class="admin-nav-heading">Tổng quan</p>
                <a class="admin-nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fa fa-house"></i>
                    <span>Quay lại trang chủ</span>
                </a>

                <a class="admin-nav-link @(currentController=="Admin" && currentAction=="Dashboard" ? "active" : "")"
                   asp-controller="Admin" asp-action="Dashboard">
                    <i class="fa fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                <a class="admin-nav-link @(currentController=="Admin" && currentAction=="Users" ? "active" : "")"
                   asp-controller="Admin" asp-action="Users">
                    <i class="fa fa-users-gear"></i>
                    <span>Quản lý user</span>
                </a>

                <a class="admin-nav-link @(currentController=="Admin" && currentAction=="LichSuDonHang" ? "active" : "")"
                   asp-controller="Admin" asp-action="LichSuDonHang">
                    <i class="fa fa-clock-rotate-left"></i>
                    <span>Lịch sử đơn hàng</span>
                </a>
            </div>

            <!-- Bán hàng -->
            <div class="admin-nav-section">
                <p class="admin-nav-heading">Quản lý bán hàng</p>

                <a class="admin-nav-link @(currentController=="AdminProduct" ? "active" : "")"
                   asp-controller="AdminProduct" asp-action="Index">
                    <i class="fa fa-box-open"></i>
                    <span>Sản phẩm</span>
                </a>

                <a class="admin-nav-link @(currentController=="AdminCategory" ? "active" : "")"
                   asp-controller="AdminCategory" asp-action="Index">
                    <i class="fa fa-tags"></i>
                    <span>Danh mục</span>
                </a>

                <a class="admin-nav-link @(currentController=="AdminReport" ? "active" : "")"
                   asp-controller="AdminReport" asp-action="Index">
                    <i class="fa fa-chart-pie"></i>
                    <span>Thống kê</span>
                </a>

                <a class="admin-nav-link @(currentController=="AdminCoupon" ? "active" : "")"
                   asp-controller="AdminCoupon" asp-action="Index">
                    <i class="fa fa-ticket"></i>
                    <span>Mã giảm giá</span>
                </a>
            </div>

            <!-- Khách hàng & nhân sự -->
            <div class="admin-nav-section">
                <p class="admin-nav-heading">Khách hàng & nhân sự</p>

                <a class="admin-nav-link @(currentController=="AdminStaff" ? "active" : "")"
                   asp-controller="AdminStaff" asp-action="Index">
                    <i class="fa fa-user-tie"></i>
                    <span>Nhân viên</span>
                </a>

                <a class="admin-nav-link @(currentController=="AdminCustomer" ? "active" : "")"
                   asp-controller="AdminCustomer" asp-action="Index">
                    <i class="fa fa-users"></i>
                    <span>Khách hàng</span>
                </a>
                <a class ="admin-nav-link @(currentController == "AdminContact" ? "active" : "")"
                asp-controller="AdminContact" asp-action="Index">
                <i class="fa fa-comments"></i>
                <span>Tin nhắn khách</span>
                </a>
            </div>

            <div class="admin-nav-section admin-nav-footer">
                <p class="admin-nav-heading">Tài khoản</p>
                <a class="admin-nav-link logout-link" asp-controller="Admin" asp-action="Logout">
                    <i class="fa fa-arrow-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </a>
               
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div class="admin-content-wrapper">

            <main class="admin-main">
                @if (TempData["StatusMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
                {
                    <div class="alert alert-success admin-flash">@msg</div>
                }
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; @DateTime.Now.Year - Mỹ Nghệ Việt Admin
            </footer>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
