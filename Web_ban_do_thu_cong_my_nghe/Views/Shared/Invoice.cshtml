@using System.Linq
@model Web_ban_do_thu_cong_my_nghe.ViewModels.InvoiceVM
@{
    Layout = Model.IsAdminView ? "~/Views/Shared/_LayoutAdmin.cshtml" : "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Hóa đơn #{Model.OrderId}";
}

<section class="invoice-shell">
    <div class="invoice-header">
        <div>
            <h1 class="invoice-title">Hóa đơn #@Model.OrderId</h1>
            <p class="text-muted mb-0">Ngày đặt: @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="text-end">
            <span class="badge @Model.StatusClass">@Model.StatusLabel</span>
            <div class="mt-3">
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                    <i class="fas fa-print me-2"></i>In hóa đơn
                </button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="invoice-card">
                <h5 class="mb-2">Thông tin khách hàng</h5>
                <p class="mb-1"><strong>@Model.CustomerName</strong></p>
                <p class="mb-1">Email: @(!string.IsNullOrWhiteSpace(Model.CustomerEmail) ? Model.CustomerEmail : "Không cung cấp")</p>
                    @if (Model.DiscountAmount > 0)
                    {
                        <p class="mb-1 text-success">Giảm giá:</p>
                    }
                <p class="mb-0">SĐT: @Model.CustomerPhone</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="invoice-card">
                <h5 class="mb-2">Địa chỉ giao hàng</h5>
                <p class="mb-1">@Model.ShippingAddress</p>
                    @if (Model.DiscountAmount > 0)
                    {
                        <p class="mb-1 text-success">-@Model.DiscountAmount.ToString("N0") đ</p>
                    }
                <p class="mb-0">Ghi chú: @(!string.IsNullOrWhiteSpace(Model.Notes) ? Model.Notes : "Không có")</p>
            </div>
        </div>
    </div>

    <div class="invoice-panel">
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Chưa có sản phẩm nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-end">@item.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="invoice-summary">
            <div>
                <p class="mb-1">Tạm tính:</p>
                <p class="mb-1">Phí vận chuyển:</p>
                <p class="mb-1">Mã giảm giá: </p>
                <p class="mb-1">Thuế (@(Model.TaxRate * 100)%) :</p>
                
                <p class="fw-bold mb-0">Tổng thanh toán:</p>
            </div>
            <div class="text-end">
                <p class="mb-1">@Model.Subtotal.ToString("N0") đ</p>
                <p class="mb-1">@Model.ShippingFee.ToString("N0") đ</p>
                <p class="mb-1">@Model.DiscountAmount.ToString("N0") đ</p>
                <p class="fw-bold mb-1">@Model.TaxAmount.ToString("N0") đ</p>
                <p class="fw-bold text-danger mb-0">@Model.TotalAfterTax.ToString("N0") đ</p>
            </div>
        </div>
    </div>

    <div class="text-end mt-4">
        @if (!string.IsNullOrEmpty(Model.BackUrl))
        {
            <a class="btn btn-outline-primary" href="@Model.BackUrl">
                ← @Model.BackLabel
            </a>
        }
        else
        {
            <a class="btn btn-outline-primary" href="/">
                ← Quay về trang chủ
            </a>
        }
    </div>
</section>

<style>
    .invoice-shell { background: #fff; padding: 32px; border-radius: 18px; box-shadow: 0 18px 40px rgba(0,0,0,0.04); }
    .invoice-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 24px; }
    .invoice-title { font-size: 2rem; font-weight: 700; }
    .invoice-card { border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; padding: 16px; background: rgba(240,130,27,0.04); height: 100%; }
    .invoice-panel { border: 1px solid rgba(0,0,0,0.08); border-radius: 16px; padding: 24px; background: #fff; }
    .invoice-summary { display: flex; justify-content: space-between; margin-top: 16px; font-size: 1.05rem; }
    @@media print {
        body { background: #fff; }
        .invoice-shell { box-shadow: none; margin: 0; }
        nav, header, footer, .btn, .order-history-shell, .order-history-header { display: none !important; }
    }
</style>
