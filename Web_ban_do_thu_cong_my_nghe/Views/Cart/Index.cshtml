@model IEnumerable<Web_ban_do_thu_cong_my_nghe.ViewModels.CartItem>
@using System.Linq
@using Web_ban_do_thu_cong_my_nghe.Data
@{
    ViewData["Title"] = "Giỏ hàng";
    var hasItems = Model.Any();
    var subtotal = ViewBag.CartSubtotal is decimal sub ? sub : 0m;
    var shippingFee = ViewBag.ShippingFee is decimal ship ? ship : 0m;
    var discountAmount = ViewBag.DiscountAmount is decimal discount ? discount : 0m;
    var totalBeforeTax = ViewBag.CartTotalBeforeTax is decimal beforeTax ? beforeTax : subtotal + shippingFee - discountAmount;
    var taxAmount = ViewBag.CartTax is decimal tax ? tax : 0m;
    var taxRate = ViewBag.CartTaxRate is decimal rate ? rate : 0m;
    var total = ViewBag.CartTotal is decimal totalValue ? totalValue : totalBeforeTax + taxAmount;
    var appliedCoupon = ViewBag.CouponCode as string ?? string.Empty;
    var couponDescription = ViewBag.CouponDescription as string ?? string.Empty;
    var couponMessage = ViewBag.CouponMessage as string;
    var updateQuantityUrl = Url.Action("UpdateQuantity", "Cart");
    var availableCoupons = ViewBag.AvailableCoupons as IEnumerable<DiscountCode> ?? Enumerable.Empty<DiscountCode>();
    var hasAvailableCoupons = availableCoupons.Any();
}

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge rounded-pill bg-dark text-uppercase">Giỏ hàng của bạn</span>
            <h2 class="mt-2 mb-1">@((hasItems ? "Kiểm tra lại trước khi thanh toán" : "Bạn chưa có sản phẩm nào"))</h2>
            <p class="text-muted mb-0">Theo dõi số lượng, áp dụng mã giảm giá và hoàn tất đơn hàng chỉ với vài bước.</p>
        </div>
        <div class="text-end">
            <p class="fs-4 fw-semibold text-primary mb-1">@subtotal.ToString("N0") đ</p>
            <small class="text-muted">Tổng phụ hiện tại</small>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(couponMessage))
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4">
            <i class="fa fa-info-circle me-2"></i>@couponMessage
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: Danh sách sản phẩm + coupon -->
        <div class="col-lg-8">
            <!-- Card sản phẩm -->
            <div class="card shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    @if (hasItems)
                    {
                        <div class="table-responsive" data-cart-table data-update-url="@updateQuantityUrl">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-uppercase small text-muted">
                                    <tr>
                                        <th class="ps-4">Sản phẩm</th>
                                        <th>Mã</th>
                                        <th>Đơn giá</th>
                                        <th style="width:120px;">Số lượng</th>
                                        <th>Thành tiền</th>
                                        <th class="text-center pe-4">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr data-item-id="@item.MaHh" class="border-top">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="ratio ratio-1x1 rounded-3 bg-light" style="width:64px;">
                                                        <img src="@($"/hinh/{item.Hinh}")" alt="@item.TenHH" class="img-fluid rounded-3" onerror="this.style.display='none'" />
                                                    </div>
                                                    <div>
                                                        <a class="fw-semibold text-decoration-none" asp-action="Detail" asp-controller="HangHoa" asp-route-id="@item.MaHh">@item.TenHH</a>
                                                       
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted">#@item.MaHh</td>
                                            <td class="fw-semibold">@item.DonGia.ToString("N0") đ</td>
                                            <td>
                                                <div class="input-group quantity mx-auto" style="width: 120px;">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-quantity-action="decrease"><i class="fa fa-minus"></i></button>
                                                    <input type="text" class="form-control form-control-sm text-center border-0 quantity-input" value="@item.SoLuong">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-quantity-action="increase"><i class="fa fa-plus"></i></button>
                                                </div>
                                            </td>
                                            <td class="fw-semibold line-total" data-line-total>@item.ThanhTien.ToString("N0") đ</td>
                                            <td class="text-center pe-4">
                                                <a asp-action="RemoveCart" asp-controller="Cart" asp-route-id="@item.MaHh" class="btn btn-light rounded-circle shadow-sm">
                                                    <i class="fa fa-times text-danger"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-shopping-basket fa-3x text-primary mb-3"></i>
                            <h5>Giỏ hàng của bạn đang trống</h5>
                            <p class="text-muted">Khám phá sản phẩm và thêm vào giỏ để bắt đầu mua sắm.</p>
                            <a class="btn btn-primary rounded-pill px-4" asp-controller="HangHoa" asp-action="Index">Tiếp tục mua sắm</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Card mã giảm giá -->
            <div class="card shadow-sm rounded-4 mb-4 p-3">
                <form asp-action="ApplyCoupon" method="post" class="d-flex gap-2" data-coupon-form>
                    @Html.AntiForgeryToken()
                    <input type="text" name="couponCode" class="form-control rounded-pill" placeholder="Nhập mã giảm giá" value="@appliedCoupon" data-coupon-input @(hasItems ? null : "disabled") />
                    <button type="submit" class="btn btn-primary rounded-pill" @(hasItems ? null : "disabled")>Áp dụng</button>
                </form>

                @if (!string.IsNullOrEmpty(appliedCoupon))
                {
                    <form asp-action="RemoveCoupon" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary rounded-pill">Hủy mã</button>
                    </form>
                }

                @if (hasItems && hasAvailableCoupons)
                {
                    <div class="mt-3">
                        <h6 class="mb-2">Gợi ý mã giảm giá</h6>
                        <div class="row g-2">
                            @foreach (var coupon in availableCoupons)
                            {
                                var percentText = (coupon.PercentOff ?? 0m) > 0 ? $"{coupon.PercentOff.Value * 100:0.#}%" : null;
                                var amountText = (coupon.AmountOff ?? 0m) > 0 ? $"{coupon.AmountOff.Value:N0} đ" : null;
                                var valueText = percentText ?? amountText ?? "Ưu đãi";
                                var minOrderText = coupon.MinOrderValue > 0 ? $"ĐH tối thiểu {coupon.MinOrderValue:N0} đ" : "Không yêu cầu tối thiểu";
                                var expiryText = coupon.EndDate.HasValue ? $"Hết hạn: {coupon.EndDate.Value:dd/MM/yyyy}" : "Không giới hạn";

                                <div class="col-md-6">
                                    <div class="border rounded-4 p-3 h-100 bg-light d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge bg-success text-white fw-semibold">@coupon.Code</span>
                                                <small class="text-muted">@expiryText</small>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(coupon.Description))
                                            {
                                                <p class="small text-muted mb-1">@coupon.Description</p>
                                            }
                                            <p class="fw-semibold mb-1">Giảm @valueText</p>
                                            <p class="small text-muted mb-2">@minOrderText</p>
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm w-100" data-apply-coupon="@coupon.Code">Áp dụng mã này</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Tổng quan đơn hàng -->
        <div class="col-lg-4">
            <div class="card shadow-sm rounded-4 " >
                <div class="card-body p-4">
                    <h5 class="mb-3">Tổng quan đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2"><span>Tổng phụ</span><span data-cart-subtotal>@subtotal.ToString("N0") đ</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Vận chuyển</span><span data-shipping-fee>@shippingFee.ToString("N0") đ</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Thuế (@(taxRate * 100)%)</span><span data-tax-amount>@taxAmount.ToString("N0") đ</span></div>
                    @if (discountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success" data-discount-row><span>Giảm giá</span><span data-discount-amount>-@discountAmount.ToString("N0") đ</span></div>
                    }
                    <hr />
                    
                    <div class="d-flex justify-content-between fs-5 fw-bold text-primary mb-3"><span>Tổng thanh toán</span><span data-cart-total>@total.ToString("N0") đ</span></div>

                    @* Nút thanh toán fix lỗi Razor *@
                    @if (hasItems)
                    {
                        <a class="btn btn-primary rounded-pill w-100" asp-action="Checkout" asp-controller="Cart">Tiến hành thanh toán</a>
                    }
                    else
                    {
                        <button class="btn btn-primary rounded-pill w-100" type="button" disabled>Tiến hành thanh toán</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cartTable = document.querySelector('[data-cart-table]');
            if (!cartTable) return;

            const updateUrl = cartTable.getAttribute('data-update-url');
            const formatter = new Intl.NumberFormat('vi-VN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

            // Xử lý + / -
            cartTable.querySelectorAll('[data-quantity-action]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const input = btn.closest('.quantity').querySelector('input');
                    let val = parseInt(input.value);
                    val = btn.dataset.quantityAction === 'increase' ? val + 1 : val - 1;
                    if (val < 1) val = 1;
                    input.value = val;
                    input.dispatchEvent(new Event('change'));
                });
            });

            // Cập nhật số lượng
            cartTable.querySelectorAll('.quantity-input').forEach(input => {
                input.addEventListener('change', () => {
                    const row = input.closest('tr');
                    const id = row.dataset.itemId;
                    fetch(updateUrl, {
                        method: 'POST',
                        body: new URLSearchParams({ id, quantity: input.value })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) throw new Error(data.message);
                        const lineTotalEl = row.querySelector('[data-line-total]');
                        if (lineTotalEl) lineTotalEl.textContent = formatter.format(data.lineTotal) + ' đ';

                        const subtotalEl = document.querySelector('[data-cart-subtotal]');
                        if (subtotalEl) subtotalEl.textContent = formatter.format(data.subtotal) + ' đ';

                        const shippingEl = document.querySelector('[data-shipping-fee]');
                        if (shippingEl && data.shippingFee !== undefined) shippingEl.textContent = formatter.format(data.shippingFee) + ' đ';

                        const taxEl = document.querySelector('[data-tax-amount]');
                        if (taxEl && data.taxAmount !== undefined) taxEl.textContent = formatter.format(data.taxAmount) + ' đ';

                        const totalBeforeTaxEl = document.querySelector('[data-total-before-tax]');
                        if (totalBeforeTaxEl && data.totalBeforeTax !== undefined) totalBeforeTaxEl.textContent = formatter.format(data.totalBeforeTax) + ' đ';

                        const totalEl = document.querySelector('[data-cart-total]');
                        if (totalEl) totalEl.textContent = formatter.format(data.totalAfterTax ?? data.total ?? 0) + ' đ';

                        const discountRow = document.querySelector('[data-discount-row]');
                        const discountAmountEl = document.querySelector('[data-discount-amount]');
                        if (discountRow && discountAmountEl) {
                            if (data.discount > 0) {
                                discountRow.classList.remove('d-none');
                                discountAmountEl.textContent = '-' + formatter.format(data.discount) + ' đ';
                            } else {
                                discountRow.classList.add('d-none');
                                discountAmountEl.textContent = '-0 đ';
                            }
                        }
                    })
                    .catch(err => alert(err.message));
                });
            });

            // Áp dụng mã nhanh
            const quickApplyButtons = document.querySelectorAll('[data-apply-coupon]');
            const couponForm = document.querySelector('[data-coupon-form]');
            const couponInput = couponForm?.querySelector('[data-coupon-input]');

            quickApplyButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const code = btn.dataset.applyCoupon;
                    if (!code || !couponForm || !couponInput) {
                        return;
                    }
                    couponInput.value = code;
                    couponForm.submit();
                });
            });
        });
    </script>
}
