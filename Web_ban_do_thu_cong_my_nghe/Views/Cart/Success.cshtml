@{
    ViewData["Title"] = "Đặt hàng thành công";
}
<div class="container py-5 text-center">
    <h1 class="text-success mb-4">🎉 Đặt hàng thành công!</h1>
    @if (ViewBag.OrderReference is string orderRef && !string.IsNullOrWhiteSpace(orderRef))
    {
        <p class="fw-semibold">Mã đơn hàng của bạn: <span class="text-primary">#@orderRef</span></p>
    }
    <p>Cảm ơn bạn đã mua hàng. Chúng tôi sẽ liên hệ để xác nhận đơn hàng sớm nhất.</p>
    <a href="/" class="btn btn-primary mt-3">Về trang chủ</a>
</div>

