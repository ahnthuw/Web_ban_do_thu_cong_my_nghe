@using System.Linq
@model IEnumerable<Web_ban_do_thu_cong_my_nghe.Data.DiscountCode>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = ViewData["Title"] ?? "Mã giảm giá";
}

<section class="admin-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">Quản lý mã giảm giá</h1>
            <p class="text-muted mb-0">Tạo và theo dõi mã ưu đãi cho khách hàng</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="fa fa-plus me-2"></i>Tạo mã mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Mô tả</th>
                    <th>Giảm</th>
                    <th>Đơn tối thiểu</th>
                    <th>Thời gian</th>
                    <th>Số lượt</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">Chưa có mã giảm giá nào.</td>
                </tr>
            }
            else
            {
                foreach (var coupon in Model)
                {
                    var valueText = coupon.PercentOff.HasValue && coupon.PercentOff > 0
                        ? $"{(coupon.PercentOff.Value * 100m):0.#}%"
                        : coupon.AmountOff.HasValue && coupon.AmountOff > 0
                            ? $"{coupon.AmountOff.Value:0,0} đ"
                            : "-";
                    var periodText = coupon.EndDate.HasValue
                        ? $"{coupon.StartDate:dd/MM/yyyy} - {coupon.EndDate:dd/MM/yyyy}"
                        : $"Từ {coupon.StartDate:dd/MM/yyyy}";
                    var usageText = coupon.UsageLimit > 0
                        ? $"{coupon.TimesUsed}/{coupon.UsageLimit}"
                        : $"{coupon.TimesUsed} / ∞";
                    <tr>
                        <td class="fw-semibold">@coupon.Code</td>
                        <td>@(coupon.Description ?? "-")</td>
                        <td>@valueText</td>
                        <td>@coupon.MinOrderValue.ToString("N0") đ</td>
                        <td>@periodText</td>
                        <td>@usageText</td>
                        <td>
                            <span class="badge @(coupon.IsActive ? "bg-success" : "bg-secondary")">
                                @(coupon.IsActive ? "Đang bật" : "Tạm dừng")
                            </span>
                        </td>
                        <td class="text-end">
                            <form asp-action="Toggle" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@coupon.Id" />
                                <button type="submit" class="btn btn-sm @(coupon.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(coupon.IsActive ? "Tạm dừng" : "Kích hoạt")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
